{
  "name": "camp-8-ways-com",
  "private": true,
  "scripts": {
    "build:calendar-pricing": "esbuild src/bundle/campCalendarPricing.ts --bundle --format=iife --outfile=assets/js/camp-calendar-pricing.js",
    "build": "npm run build:calendar-pricing",
    "seo:map": "python3 scripts/build-seo-map.py",
    "seo:og": "/usr/bin/python3 scripts/generate-og-images.py",
    "seo:fix-links": "python3 scripts/fix-known-internal-links.py",
    "seo:image-dimensions": "/usr/bin/python3 scripts/add-image-dimensions.py",
    "seo:apply": "python3 scripts/apply-seo.py",
    "seo:sitemap": "python3 scripts/generate-sitemap.py",
    "seo:audit": "python3 scripts/audit-seo.py",
    "seo:audit-assets": "python3 scripts/audit-site-assets.py",
    "seo:export": "python3 scripts/export-seo-table.py",
    "seo": "npm run seo:map && npm run seo:og && npm run seo:map && npm run seo:apply && npm run seo:fix-links && npm run seo:image-dimensions && npm run seo:sitemap && npm run seo:audit-assets && npm run seo:audit && npm run seo:export"
  },
